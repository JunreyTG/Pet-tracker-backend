APP_NAME="Pet Tracker Backend"
APP_VERSION="0.1.0"
DEBUG=false

# Local path to the Firebase service-account JSON file.
# Do not commit the real file or paste its contents here.
FIREBASE_CREDENTIALS_PATH=".credentials/firebase-service-account.json"

# Optional. If omitted, Firebase can use the project_id from the service-account JSON.
FIREBASE_PROJECT_ID=""

# Device heartbeat threshold. Devices are marked offline only when
# current UTC time - last_seen is strictly greater than this value.
DEVICE_OFFLINE_THRESHOLD_SECONDS=300

# Low-battery alert threshold. A low-battery alert is created when telemetry
# reports battery_level <= this value and the device is not already in an
# active low-battery alert state.
LOW_BATTERY_THRESHOLD_PERCENT=20
