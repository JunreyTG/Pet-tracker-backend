APP_NAME="Pet Tracker Backend"
APP_VERSION="0.1.0"
DEBUG=false

# Local path to the Firebase service-account JSON file.
# Do not commit the real file or paste its contents here.
FIREBASE_CREDENTIALS_PATH=".credentials/firebase-service-account.json"

# Optional. If omitted, Firebase can use the project_id from the service-account JSON.
FIREBASE_PROJECT_ID="pet-tracker-12345"

# Secret used to sign app login tokens. Change this for any shared environment.
AUTH_TOKEN_SECRET="replace-with-a-long-random-secret"
AUTH_TOKEN_TTL_SECONDS=604800

# Same private random key for this backend and the offline tracker identity tool.
# Do not embed the key itself in the app or firmware.
# TRACKER_FACTORY_KEY="set-a-long-random-key-at-least-32-characters"

# Device heartbeat threshold. Devices are marked offline only when
# current UTC time - last_seen is strictly greater than this value.
DEVICE_OFFLINE_THRESHOLD_SECONDS=300

# How often the in-process FastAPI heartbeat loop checks for offline devices.
# For multi-worker production deployments, prefer a single external scheduler.
DEVICE_HEARTBEAT_CHECK_INTERVAL_SECONDS=60

# Vercel: set a long random secret (at least 32 characters) and configure a
# single external scheduler to POST /internal/check-offline with Bearer auth.
# DEVICE_OFFLINE_CHECK_SECRET="set-in-production-only"

# Low-battery alert threshold. A low-battery alert is created when telemetry
# reports battery_level <= this value and the device is not already in an
# active low-battery alert state.
LOW_BATTERY_THRESHOLD_PERCENT=20

# Optional transactional email via Brevo (https://www.brevo.com) for email alerts.
# BREVO_API_KEY must be a server-side API key;
# ALERT_EMAIL_FROM must be a bare, verified sender address in Brevo.
BREVO_API_KEY="replace-with-your-brevo-api-key"
ALERT_EMAIL_FROM="trackerpet22@gmail.com"
